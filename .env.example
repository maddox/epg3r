# Copy to .env and edit. docker compose reads .env automatically; `make up` builds the
# image and boots it with these values. Nothing here is committed.
#
# Seeds apply on first boot only, and only to settings never set before; leave a value
# empty to take the app default (shown in each comment) and keep receiving default
# changes on upgrade.

# Your provider's playlist. Required on first boot; afterwards the database owns it.
EPG3R_M3U_URL=http://provider.example/playlist.m3u

# Your provider's XMLTV guide, if they publish one. Optional.
EPG3R_XMLTV_URL=

# Minutes between refreshes. Default 60.
EPG3R_REFRESH_INTERVAL=

# Zone for times in channel titles that do not say. Default America/New_York.
EPG3R_TIMEZONE=

# How Channels DVR reaches this container, for absolute URLs in the output.
# Default: derived from each request.
EPG3R_PUBLIC_URL=

# debug | info | warn | error. Default info.
EPG3R_LOG_LEVEL=

# Host port to publish the app on. Default 8080.
EPG3R_PORT=
