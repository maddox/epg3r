# Copy to .env and edit. docker compose reads .env automatically; `make up` builds the
# image and boots it with these values. Nothing here is committed.
#
# Only what the process needs before it has a database lives here. Everything else — your
# provider's URLs, how often to refresh, where the channel numbers start — is set in the
# app, which walks you through it the first time you open it.

# debug | info | warn | error. Default info.
EPG3R_LOG_LEVEL=

# Host port to publish the app on. Default 8080.
EPG3R_PORT=
